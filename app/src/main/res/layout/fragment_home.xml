<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baby_pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="🐰 识字乐园"
            android:textColor="@color/primary_red"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLearnedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="已经认识 0 个字啦"
            android:textColor="@color/text_dark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="🪙 金币：0"
            android:textColor="@color/primary_purple"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 大兔子 -->
        <TextView
            android:id="@+id/bigRabbit"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="🐰"
            android:textSize="130sp" />

        <!-- 四个功能按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnLearn"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:text="📖\n学一学"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_button_blue"
                android:gravity="center"
                android:padding="8dp"
                android:text="🎮\n玩一玩"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnRabbit"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_button_green"
                android:gravity="center"
                android:padding="8dp"
                android:text="🎀\n小兔子"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnProgress"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_button_purple"
                android:gravity="center"
                android:padding="8dp"
                android:text="🏆\n我的奖章"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="❤ 宝贝加油！"
            android:textColor="@color/primary_coral"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>
